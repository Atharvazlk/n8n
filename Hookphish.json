    {
      "parameters": {
        "jsCode": "// ----------------------------------------------\n// Get input HTML or text\n// ----------------------------------------------\nconst htmlContent = $input.first().json.textAsHtml\n    || $input.first().json.html\n    || $input.first().json.text\n    || \"\";\n\n// ----------------------------------------------\n// Extract URLs from anchor tags\n// ----------------------------------------------\nfunction extractUrlsFromHtml(html) {\n    const urls = [];\n    const anchorRegex = /<a[^>]+href=[\"'](https?:\\/\\/[^\"']+)[\"']/gi;\n    let match;\n\n    while ((match = anchorRegex.exec(html)) !== null) {\n        urls.push(match[1]);\n    }\n    return urls;\n}\n\n// ----------------------------------------------\n// Extract URLs from plain text\n// ----------------------------------------------\nfunction extractUrlsFromText(text) {\n    const urls = [];\n    const urlRegex = /https?:\\/\\/[^\\s\"'<>]+/g;\n    let match;\n\n    while ((match = urlRegex.exec(text)) !== null) {\n        urls.push(match[0]);\n    }\n    return urls;\n}\n\n// ----------------------------------------------\n// Decide extraction method\n// ----------------------------------------------\nlet urls = [];\n\nif (/<a[^>]+href=/i.test(htmlContent)) {\n    urls = extractUrlsFromHtml(htmlContent);\n} else {\n    urls = extractUrlsFromText(htmlContent);\n}\n\n// ----------------------------------------------\n// Deduplicate + format as required\n// ----------------------------------------------\nurls = [...new Set(urls)].map(url => ({ urll: url }));\n\n// Debug log\nconsole.log(\"Extracted URLs:\", urls);\n\n// ----------------------------------------------\n// Return final object structure\n// ----------------------------------------------\nreturn [\n    {\n        json: {\n            urls: urls\n        }\n    }\n];\n"
      },

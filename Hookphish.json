        "message": "=<!DOCTYPE html>\n<html>\n  <body style=\"font-family: Arial, sans-serif; color: #333; line-height: 1.6;\">\n\n    <h2>🔐 Data Breach Snapshot</h2>\n\n    <p><strong>Entity Name:</strong> {{ $json[\"Entity Name\"] }}</p>\n\n    <p><strong>Headquarters:</strong> {{ $json[\"Headquarters\"] }}</p>\n\n    <p><strong># Impacted:</strong> {{ $json[\"Impacted\"] }}</p>\n\n    <p><strong>Date of Breach:</strong> {{ $json[\"Date of Breach\"] }}</p>\n\n    <p><strong>Date Published:</strong> {{ $json[\"Date Published\"] }}</p>\n\n    <p><strong>Information Compromised:</strong><br>\n      {{ $json[\"Information Compromised\"] }}\n    </p>\n\n    <p><strong>Link to Where I Found Out About the Breach:</strong><br>\n      <a href=\"{{ $('Loop Over Items').item.json.urll }}\" target=\"_blank\">\n        {{ $('Loop Over Items').item.json.urll }}\n      </a>\n    </p>\n\n    <p><strong>External Source Link:</strong><br>\n      <a href=\"{{ $json[\"External Source Link\"] }}\" target=\"_blank\">\n        {{ $json[\"External Source Link\"] }}\n      </a>\n    </p>\n\n    <p><strong>Company URL:</strong><br>\n      <a href=\"{{ $json[\"Company URL\"] }}\" target=\"_blank\">\n        {{ $json[\"Company URL\"] }}\n      </a>\n    </p>\n\n  </body>\n</html>\n",

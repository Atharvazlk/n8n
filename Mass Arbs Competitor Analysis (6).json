    {
      "parameters": {
        "jsCode": "// --------------------------------------------------\n// Read Landing Page Link from OpenAI node\n// --------------------------------------------------\nconst url =\n $('Loop Over Items').first().json.url||\n  \"\";\n\n// --------------------------------------------------\n// Determine Mass Arb Competitor Name\n// --------------------------------------------------\nfunction getMassArbCompetitorName(link) {\n  const u = String(link).toLowerCase();\n\n  // Special rule: Lantern OR Labaton\n  if (u.includes(\"lantern\") || u.includes(\"labaton\")) {\n    return \"Labaton Keller Sucharow\";\n  }\n\n  if (u.includes(\"classaction.org\")) return \"ClassAction.org\";\n  if (u.includes(\"consumerprotection\")) return \"ConsumerProtection Law\";\n  if (u.includes(\"lowey.com\")) return \"Lowey Dannenberg\";\n  if (u.includes(\"ag.ny.gov\")) return \"NEW YORK AG\";\n  if (u.includes(\"texasattorneygeneral\")) return \"TEXAS AG\";\n  if (u.includes(\"forthepeople.com\")) return \"Morgan & Morgan\";\n  if (u.includes(\"sirillp.com\")) return \"Siri & Glimstad LLP\";\n  if (u.includes(\"crosnerlegal.com\")) return \"Crosner Legal\";\n  if (u.includes(\"clarksonlawfirm.com\")) return \"Clarkson Law Firm\";\n  if (u.includes(\"shamisgentile.com\")) return \"Shamis & Gentile\";\n  if (u.includes(\"bergermontague.com\")) return \"Berger Montague\";\n  if (u.includes(\"zrclaims.com\")) return \"ZR Claims\";\n\n  return \"Not specified\";\n}\n\n// --------------------------------------------------\n// Output\n// --------------------------------------------------\nreturn [\n  {\n    json: {\n      \"Landing Page Link\": url,\n      \"Mass Arb Competitor Name\": getMassArbCompetitorName(url),\n    },\n  },\n];\n"
      },

    {
      "parameters": {
        "jsCode": "// Input from previous node\nconst htmlContent = $input.first().json.textAsHtml \n    || $input.first().json.html \n    || $input.first().json.text \n    || \"\";\n\n// ------------------------------------------------------------\n// Extract URLs from <a href=\"...\">\n// ------------------------------------------------------------\nfunction extractUrlsFromHtml(html) {\n    const urls = [];\n    const anchorRegex = /<a[^>]+href=[\"'](https?:\\/\\/[^\"']+)[\"']/gi;\n    let match;\n\n    while ((match = anchorRegex.exec(html)) !== null) {\n        urls.push(match[1]);\n    }\n    return urls;\n}\n\n// ------------------------------------------------------------\n// Extract URLs from plain text\n// ------------------------------------------------------------\nfunction extractUrlsFromText(text) {\n    const urls = [];\n    const urlRegex = /https?:\\/\\/[^\\s\"'<>]+/g;\n    let match;\n\n    while ((match = urlRegex.exec(text)) !== null) {\n        urls.push(match[0]);\n    }\n    return urls;\n}\n\n// ------------------------------------------------------------\n// Decide which extractor to use\n// ------------------------------------------------------------\nlet urls = [];\n\nif (/<a[^>]+href=/i.test(htmlContent)) {\n    // Extract only from anchor tags first\n    urls = extractUrlsFromHtml(htmlContent);\n} else {\n    // Fallback to plain text extraction\n    urls = extractUrlsFromText(htmlContent);\n}\n\n// ------------------------------------------------------------\n// Deduplicate and format output\n// ------------------------------------------------------------\nurls = [...new Set(urls)]  // remove duplicates\n    .map(url => ({ url })); // convert to array of objects\n\n// Console debug\nconsole.log(\"Extracted URLs:\", urls);\n\n// Return in n8n format\nreturn [\n    {\n        json: {\n            \n            urls: urls\n        }\n    }\n];\n"
      },

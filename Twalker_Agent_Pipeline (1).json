    {
      "parameters": {
        "jsCode": "// Read the last processed timestamp from MongoDB\nconst lastRunDoc = $('Get Last Processed Timestamp').first().json;\nconst lastRun = lastRunDoc.value || '1970-01-01';\n\n// Keep only rows with a first_seen after the last run\nconst newItems = items.filter(item => {\n  return item.json.first_seen > lastRun;\n});\n\n// Track the newest timestamp seen, to pass along for the write-back step\nlet newest = lastRun;\nif (newItems.length > 0) {\n  newest = newItems.reduce((max, item) => {\n    return item.json.first_seen > max ? item.json.first_seen : max;\n  }, lastRun);\n}\n\n// Attach the newest timestamp to each outgoing item so the later Update node can use it\nreturn newItems.map(item => ({\n  json: {\n    ...item.json,\n    _newestTimestamp: newest\n  }\n}));"
      },

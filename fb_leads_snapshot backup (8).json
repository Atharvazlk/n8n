    {
      "parameters": {
        "jsCode": "// ------------------------------\n// Safely read incoming data\n// ------------------------------\nconst first = $input.first()?.json || {};\nlet records = [];\n\nif (Array.isArray(first.data1)) {\n  records = first.data1;\n} else if (Array.isArray(first.data)) {\n  records = first.data;\n} else {\n  records = $input.all().map(i => i.json);\n}\n\n// ------------------------------\n// Helper: safe clean text\n// ------------------------------\nfunction clean(t) {\n  if (!t) return \"N/A\";\n  const s = String(t).trim();\n  if (/{{\\s*[\\w.]+\\s*}}/i.test(s)) return \"N/A\";\n  if (/{%\\s*[\\w.]+\\s*%}/i.test(s)) return \"N/A\";\n  if (!/[a-zA-Z0-9]/.test(s)) return \"N/A\";\n  return s;\n}\n\n// ------------------------------\n// Helper: normalize URL\n// ------------------------------\nfunction normalizeUrl(url) {\n  if (!url || url === \"N/A\") return \"N/A\";\n  if (!/^https?:\\/\\//i.test(url)) {\n    return `https://${url}`;\n  }\n  return url;\n}\n\n// ------------------------------\n// Build Simple HTML\n// ------------------------------\nlet html = \"\";\n\nrecords.forEach((c, i) => {\n  const row = {\n    lawFirm: clean(c.law_firm_name || c[\"Law Firm Name\"]),\n    adStartDate: clean(c.ad_start_date || c[\"Ad Start Date\"]),\n    landingPage: normalizeUrl(clean(c.landing_page_url || c[\"Landing Page URL\"])),\n    caseType: clean(c.type_of_case || c[\"Type of case\"]),\n    headline: clean(c.title || c.headline || c[\"Title / Headline of the case\"]),\n    adLibrary: normalizeUrl(clean(c.ad_library_url || c[\"Ad Library URL\"])),\n    adcount: clean(c.ad_count || c[\"Ad Count\"])\n  };\n\n  // Skip if law firm name missing\n  if (row.lawFirm === \"N/A\") return;\n\n  html += `\n    <div style=\"margin-bottom:24px; font-family:Arial, sans-serif; line-height:1.6;\">\n      <h3 style=\"margin:0 0 10px 0; font-size:17px; color:#111;\">\n        ⚖️ Campaign Snapshot : ${row.lawFirm}\n      </h3>\n\n      <p><strong>Ad Start Date:</strong> ${row.adStartDate}</p>\n      <p><strong>Type of Case:</strong> ${row.caseType}</p>\n      <p><strong>Title / Headline:</strong> ${row.headline}</p>\n      <p><strong>Ads Count:</strong> ${row.adcount}</p>\n      <p><strong>Landing Page:</strong>\n        ${\n          row.landingPage !== \"N/A\"\n            ? `<a href=\"${row.landingPage}\" target=\"_blank\">${row.landingPage}</a>`\n            : \" N/A\"\n        }\n      </p>\n\n      <p><strong>Ad Library URL:</strong>\n        ${\n          row.adLibrary !== \"N/A\"\n            ? `<a href=\"${row.adLibrary}\" target=\"_blank\">${row.adLibrary}</a>`\n            : \" N/A\"\n        }\n      </p>\n\n      <hr style=\"border:none; border-top:1px solid #ddd; margin-top:14px;\">\n    </div>\n  `;\n});\n\n// ------------------------------\n// Final HTML wrapper\n// ------------------------------\nconst finalHtml = `\n<!DOCTYPE html>\n<html>\n  <body style=\"padding:16px; background:#ffffff;\">\n    ${html || \"<p>No valid campaign data found.</p>\"}\n  </body>\n</html>\n`;\n\nreturn [{ json: { html: finalHtml } }];\n"
      },
